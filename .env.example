# Copier ce fichier en .env et remplir les valeurs (.env est ignoré par git).
# Toutes les variables REACT_APP_* sont intégrées au JavaScript public au build :
# n'y mettre que des clés publiques, jamais de mot de passe ni de clé secrète.

# EmailJS : formulaire de contact
REACT_APP_EMAILJS_SERVICE_ID=
REACT_APP_EMAILJS_DEFAULT_TEMPLATE_ID=
REACT_APP_EMAILJS_TATTOO_TEMPLATE_ID=
REACT_APP_EMAILJS_PUBLIC_KEY=

# Cloudinary : images jointes aux demandes de tatouage (preset d'upload non signé)
REACT_APP_CLOUDINARY_CLOUD_NAME=
REACT_APP_CLOUDINARY_UPLOAD_PRESET=

# Supabase : actualités et avis (clé publishable, l'accès est filtré par les règles RLS)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
